// Prisma schema for Monomind's structured data (SQLite, local file, no server).
// Vector embeddings live separately in LanceDB (see src/lancedb.ts in this package).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single imported chat export conversation. This is part of the
/// immutable raw layer: once imported, its fields are never overwritten.
model Conversation {
  id        String   @id @default(cuid())
  title     String
  /// Where this conversation came from. Only "chatgpt-export" and "pasted" for v0.
  source    String
  createdAt DateTime @default(now())

  messages Message[]
  notes    Note[]
  chunks   Chunk[]
}

/// A single message within a conversation. Immutable raw layer.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant" | "system"
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// A chunk of a conversation prepared for embedding (~500 tokens),
/// respecting message boundaries. The chunk TEXT and metadata live here in
/// SQLite; the actual embedding VECTOR lives in LanceDB (see src/lancedb.ts).
/// This table exists so we can track per-chunk embedding status and retry
/// just the failed ones without re-scanning LanceDB.
model Chunk {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Position of this chunk within its conversation, for ordering.
  order          Int
  text           String
  /// Id of the first Message included in this chunk.
  startMessageId String
  /// Id of the last Message included in this chunk.
  endMessageId   String
  /// Rough token count (chars/4), for debugging chunk sizing.
  tokenEstimate  Int
  /// Which embedding model produced (or will produce) this chunk's vector.
  /// Determines which LanceDB table the vector lives in.
  embeddingModel String
  /// "pending" | "done" | "failed"
  embeddingStatus String      @default("pending")
  /// Error message from the last failed embedding attempt, if any.
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([embeddingStatus])
}

/// A single "ask your knowledge base" chat thread. Currently one implicit
/// session per browser (see ChatMessage below) - no multi-thread UI yet,
/// but the schema supports it so that's an additive change later, not a
/// migration.
model ChatSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  messages ChatMessage[]
}

/// A single message in a chat thread. Persisted as it's sent/received so
/// refreshing /chat doesn't lose history.
model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role          String
  content       String
  /// Stored as a JSON-encoded array of { index, conversationId, conversationTitle }.
  /// Empty array (never null) for user messages and assistant messages with no citations.
  citations     String      @default("[]")
  createdAt     DateTime    @default(now())

  @@index([sessionId])
}

/// A structured note generated by the chat model from a conversation
/// (summary, topics, key ideas). Always linked back to its source
/// conversation so nothing is unsourced. Editable/deletable by the user.
model Note {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// A model-suggested better title, only set when the model judged the
  /// original conversation title unhelpful. Null means "use the
  /// conversation's own title" - this never overwrites the raw layer.
  titleOverride  String?
  summary        String
  /// Stored as a JSON-encoded string array (SQLite has no native array type).
  topics         String
  /// Stored as a JSON-encoded string array (SQLite has no native array type).
  keyIdeas       String
  /// Stored as a JSON-encoded string array (SQLite has no native array type).
  decisions      String @default("[]")
  /// Stored as a JSON-encoded string array (SQLite has no native array type).
  openQuestions  String @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}
